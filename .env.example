# ── APIs externas ──────────────────────────────────────────────────────────────
API_CONTRATACAO_URL=http://localhost:9090
API_ATIVOS_URL=http://localhost:9090
API_CARTOES_URL=http://localhost:9090

# ── AWS (LocalStack local) ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Aplicação ─────────────────────────────────────────────────────────────────
ENV=local
APP_VERSION=local

# ── Reconciliação ─────────────────────────────────────────────────────────────
RECONCILIACAO_TIMEOUT_MINUTOS=10
RECONCILIACAO_INTERVALO_MS=60000
